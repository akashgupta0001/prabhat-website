{
  "name": "prabhat-website",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*", "/sitemap.xml", "/robots.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prabhat-db",
      "database_id": "e7c8d4c6-e032-49ba-aeaa-31cd9a808608"
    }
  ]
}
